[Unit]
Description=VTB Monitor background scheduler and workers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vtb-monitor
Group=vtb-monitor
WorkingDirectory=/opt/vtb-monitor
EnvironmentFile=/etc/vtb-monitor.env
Environment=NODE_ENV=production`r`nEnvironment=SCHEDULER_MODE=core`r`nEnvironment=ALLOW_HISTORICAL_SYNC=0
ExecStart=/usr/bin/npx --no-install tsx scripts/scheduler.ts
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vtb-monitor
MemoryMax=384M

[Install]
WantedBy=multi-user.target


